{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "orvo",
  "version": "0.1.0",
  "identifier": "dev.orvo.workbench",
  "build": {
    "devUrl": "http://127.0.0.1:28420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "orvo",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 580,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}

